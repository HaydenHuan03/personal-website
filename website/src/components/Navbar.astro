---

<nav class="max-w-5xl mx-auto px-6 md:px-12 py-8 flex justify-center items-center bg-stone-50/80 backdrop-blur-sm sticky top-0 z-50">
  <div class="relative flex gap-6 text-sm font-medium text-stone-600 pb-1">
    <a href="/#about" data-nav-link="about" class="hover:text-stone-900 transition-colors">About</a>
    <a href="/#skills" data-nav-link="skills" class="hover:text-stone-900 transition-colors">Skills</a>
    <a href="/#leetcode" data-nav-link="leetcode" class="hover:text-stone-900 transition-colors">LeetCode</a>
    <a href="/#projects" data-nav-link="projects" class="hover:text-stone-900 transition-colors">Projects</a>
    <a href="/#journey" data-nav-link="journey" class="hover:text-stone-900 transition-colors">Journey</a>
    <span
      data-nav-indicator
      class="absolute bottom-0 left-0 h-[2px] bg-stone-900 rounded-full pointer-events-none"
      style="width:0;opacity:0"
    ></span>
  </div>
</nav>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function initNavIndicator() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
    const indicator = document.querySelector<HTMLElement>('[data-nav-indicator]');
    if (!links.length || !indicator) return;

    function moveIndicatorTo(link: HTMLElement) {
      gsap.to(indicator, {
        x: link.offsetLeft,
        width: link.offsetWidth,
        opacity: 1,
        duration: 0.3,
        ease: 'power2.out',
      });
    }

    const sectionIds = ['about', 'skills', 'leetcode', 'projects', 'journey'];
    sectionIds.forEach((id) => {
      const section = document.getElementById(id);
      const link = document.querySelector<HTMLElement>(`[data-nav-link="${id}"]`);
      if (!section || !link) return;

      ScrollTrigger.create({
        trigger: section,
        start: 'top center',
        end: 'bottom center',
        onEnter: () => moveIndicatorTo(link),
        onEnterBack: () => moveIndicatorTo(link),
      });
    });
  }

  document.addEventListener('astro:page-load', initNavIndicator);
  document.addEventListener('astro:before-swap', () => ScrollTrigger.killAll());
</script>
